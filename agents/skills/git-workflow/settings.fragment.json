{
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "hooks": {
    "WorktreeCreate": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/git-workflow/bin/git-wt hook-create",
            "timeout": 600
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/skills/git-workflow/bin/git-wt hook-remove",
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "~/.claude/skills/git-workflow/bin/git-wt guard",
            "timeout": 60
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "~/.claude/skills/git-workflow/bin/git-wt guard",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
