# Shared git settings, linked to ~/.config/git/config. git reads this file
# first and ~/.gitconfig after it, so ~/.gitconfig holds what differs per
# machine (identity, signing) and can override anything here. It also gets
# whatever `git config --global` and tools such as `gh auth setup-git`
# write, instead of this repo. Diffs are paged through delta (git-delta).

[init]
	defaultBranch = main

[fetch]
	prune = true                 # drop remote branches deleted upstream

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	cm = commit -m
	aa = add -A

[push]
	default = simple             # push the current branch to its upstream
	autoSetupRemote = true       # set the upstream on first push

[pull]
	rebase = false               # merge, don't rebase

[color]
	ui = auto

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3
