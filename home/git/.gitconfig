# Shared git settings. Identity and commit signing differ per machine and
# live in ~/.gitconfig.local, included at the end so it can override
# anything here. Diffs are paged through delta (git-delta).

[init]
	defaultBranch = main

[fetch]
	prune = true                 # drop remote branches deleted upstream

[alias]
	st = status
	co = checkout
	br = branch
	ci = commit
	cm = commit -m
	aa = add -A

[push]
	default = simple             # push the current branch to its upstream
	autoSetupRemote = true       # set the upstream on first push

[pull]
	rebase = false               # merge, don't rebase

[color]
	ui = auto

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true

[merge]
	conflictStyle = zdiff3

[include]
	path = ~/.gitconfig.local
